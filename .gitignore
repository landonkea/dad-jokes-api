# =============================================================================
# Git Ignore Rules
# =============================================================================
# This file tells Git (our version control system) which files and folders
# to IGNORE — meaning Git will never track, commit, or push them.
# This keeps our repository clean and prevents sensitive data from leaking.
#
# WHY each line exists is explained below.
# =============================================================================

# node_modules/ = The folder where all our project's dependencies (libraries)
# are installed when you run "npm install". This folder can contain THOUSANDS
# of files (100,000+!) and is huge. It's regenerated from package.json, so
# there's no need to save it. Every developer runs "npm install" to rebuild it.
node_modules/

# dist/ = The folder where compiled/built output goes after running a build
# command. For the server, this contains JavaScript files compiled from TypeScript.
# For the client, this contains the optimized production website files.
# We don't track this because it can always be regenerated from the source code.
dist/

# .env = Our environment variables file containing database passwords and
# server configuration. This MUST be ignored because it contains secrets.
# If someone got this file, they could connect to your database.
# The .env.example file (without secrets) IS tracked as a template for others.
.env

# *.log = Any file ending in ".log" — these are log files created by Node.js
# or other tools when the app runs. They can grow very large, contain
# sensitive information, and are different on every machine. Safe to ignore.
*.log

# .DS_Store = A hidden file that macOS creates in every folder you open.
# It stores your Finder preferences (like icon positions and view settings).
# It's Mac-specific junk that doesn't belong in the project.
.DS_Store
