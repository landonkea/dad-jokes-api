# =============================================================================
# Dad Jokes API — Environment Variables Template
# =============================================================================
# WHAT: This file is a TEMPLATE for the real .env file. It shows what variables
#       are needed to run the app, without containing real secrets.
# WHY:  It's committed to Git (unlike .env) so every developer can see exactly
#       what environment variables are required. New developers copy this file
#       to .env and fill in their own values.
# HOW:  The "dotenv" library in our Express server reads the .env file at
#       startup and makes each variable available via process.env.VARIABLE_NAME.
# =============================================================================

# DB_HOST = The address of the computer where PostgreSQL (our database) runs.
# "localhost" means it's on YOUR computer. If the database were hosted on a
# cloud server (like AWS RDS), you'd put that server's address/domain here.
DB_HOST=localhost

# DB_PORT = The "door number" that PostgreSQL listens on for connections.
# 5432 is PostgreSQL's standard default port (like port 80 for websites).
# Only change this if you configured PostgreSQL to use a different port.
DB_PORT=5432

# DB_USER = The username used to log into PostgreSQL.
# "postgres" is the default admin username created during PostgreSQL setup.
# In production, you'd use a less-privileged user with limited permissions.
DB_USER=postgres

# DB_PASSWORD = The password for the database user specified above.
# "postgres" is the default password (insecure — only acceptable for local dev).
# NEVER put a real production password in .env.example or commit it to Git.
DB_PASSWORD=postgres

# DB_NAME = The name of the specific database within PostgreSQL to connect to.
# PostgreSQL can hold many databases on one server. This tells our app which
# one to use. The database must exist before the app can connect to it.
DB_NAME=dad_jokes

# PORT = The port our Express API server will listen on.
# When you visit http://localhost:3001, you're hitting this server.
# This must match the proxy target in vite.config.ts so the React dev server
# knows where to forward API requests during development.
PORT=3001
